# Copy values into your shell when you need to override the local demo.
# Playwright does not load this file automatically.
# The account below exists only inside the loopback demo. It is not a production credential.

DEMO_PORT=4173
DEMO_BASE_URL=http://127.0.0.1:4173
DEMO_ADMIN_USERNAME=ada
DEMO_ADMIN_PASSWORD=local-demo

